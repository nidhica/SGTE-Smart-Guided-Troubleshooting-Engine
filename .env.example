# SGTE environment template — placeholders only. Do not commit real keys.
# Copy to .env for local use. SGTE Settings reads process env (does not auto-load .env).

# Provider: mock | none | openai | gemini | groq
SGTE_LLM_PROVIDER=none

# Optional model override (defaults depend on provider)
# SGTE_LLM_MODEL=gpt-4o-mini
# SGTE_LLM_MODEL=gemini-2.0-flash
# SGTE_LLM_MODEL=llama-3.3-70b-versatile

# Credentials — set only the keys required for the chosen provider
# SGTE_LLM_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional OpenAI-compatible / provider base URL override
# SGTE_LLM_BASE_URL=

# test | production
# SGTE_LLM_MODE=test
